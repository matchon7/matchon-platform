const FOLDER_NAME="MATCHON_상담";const SHEET_NAME="MATCHON_상담관리";
function folder_(){const f=DriveApp.getFoldersByName(FOLDER_NAME);return f.hasNext()?f.next():DriveApp.createFolder(FOLDER_NAME)}
function sheet_(){const p=PropertiesService.getScriptProperties(),id=p.getProperty("SHEET_ID");if(id){try{return SpreadsheetApp.openById(id)}catch(e){}}const s=SpreadsheetApp.create(SHEET_NAME);p.setProperty("SHEET_ID",s.getId());s.getSheets()[0].appendRow(["접수일시","유형","브랜드","성명","연락처","희망지역","예산","매장유형","문의내용","원본JSON"]);return s}
function doGet(){return ContentService.createTextOutput(JSON.stringify({ok:true,service:"MATCHON consultation API"})).setMimeType(ContentService.MimeType.JSON)}
function doPost(e){try{const d=JSON.parse(e.parameter.payload||"{}"),now=new Date(),tz=Session.getScriptTimeZone()||"Asia/Seoul",stamp=Utilities.formatDate(now,tz,"yyyy-MM-dd HH:mm:ss"),name=String(d.name||"unknown").replace(/[\\\\/:*?"<>|]/g,"_");folder_().createFile(stamp.replace(/[: ]/g,"-")+"_"+name+".json",JSON.stringify(d,null,2),MimeType.PLAIN_TEXT);sheet_().getSheets()[0].appendRow([stamp,d.type||"",d.brand||"",d.name||"",d.phone||"",d.region||"",d.budget||"",d.storeType||"",d.message||"",JSON.stringify(d)]);return ContentService.createTextOutput(JSON.stringify({ok:true})).setMimeType(ContentService.MimeType.JSON)}catch(err){return ContentService.createTextOutput(JSON.stringify({ok:false,error:String(err)})).setMimeType(ContentService.MimeType.JSON)}}
